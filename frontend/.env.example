# ShopHub Frontend - Environment Variables
# Copy this file to .env.local and fill in the values

# Backend API URL (browser - used by client-side fetches)
# Must be set for production
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Backend API URL (server - used by Next.js API routes, UploadThing auth, etc.)
# Required for server-side API calls (e.g. UploadThing middleware)
BACKEND_API_URL=http://localhost:3001/api

# Mock data - set to false for production
# When true, products/categories use local mock data instead of backend
NEXT_PUBLIC_USE_MOCKS=false

# Demo checkout - DEV ONLY, always disabled in production
# When true (and NODE_ENV !== production), orders are created client-side (no backend)
# Ignored when NODE_ENV=production for security
NEXT_PUBLIC_DEMO_CHECKOUT=false

# UploadThing – used for product, category, hero slide, and promotion image uploads in admin
# Get from https://uploadthing.com – base64-encoded JSON: { apiKey, appId, regions }
# Required for image uploads in admin (products, categories, hero slides, promotions)
# UPLOADTHING_TOKEN=
