# ShopHub Backend - Environment Variables
# Copy this file to .env and fill in the values

# Environment
NODE_ENV=development

# Server
PORT=3001

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/shopub

# JWT Authentication (use strong secrets in production)
JWT_ACCESS_SECRET=your-access-secret-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS - Frontend URL (comma-separated for multiple origins in production)
FRONTEND_URL=http://localhost:3000

# Guest order cookie max age in days (default: 7) - allows guests to revisit order confirmation
# GUEST_ORDER_COOKIE_MAX_AGE_DAYS=7

# Cart: expired guest sessions are cleaned daily at 03:00 UTC (ScheduleModule)

# Email (SMTP) - required for order confirmation emails
# Without these, emails are logged to console only (mock mode)
#
# How to configure:
# 1. Get SMTP credentials from your provider (Gmail, SendGrid, Mailgun, etc.)
# 2. Uncomment and fill in the variables below
# 3. Restart the backend
#
# Common providers:
# - Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, enable "App Password" in Google Account
# - SendGrid: SMTP_HOST=smtp.sendgrid.net, SMTP_PORT=587, use API key as SMTP_PASS
# - Mailgun: SMTP_HOST=smtp.mailgun.org, SMTP_PORT=587
# - Outlook: SMTP_HOST=smtp.office365.com, SMTP_PORT=587
#
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM="ShopHub" <noreply@shophub.com>

# Cloudinary (optional - for image uploads if not using UploadThing)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
