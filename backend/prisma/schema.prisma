// This is your Prisma schema file,
// learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum UserRole {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
}

enum FulfillmentStatus {
  UNFULFILLED
  PARTIAL
  FULFILLED
  RETURNED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum AnnouncementIconType {
  Truck
  Sparkles
  Zap
  Info
  Bell
  Tag
  Gift
}

enum HeroSlideType {
  PRODUCT_SPOTLIGHT
  OFFER
  TESTIMONIAL
  LANDSCAPE_IMAGE
  CATEGORY_SPOTLIGHT
  EDITORS_PICK
  COMPARISON_BATTLE
  PROMOTION
}

enum MediaKind {
  PRODUCT
  IMAGE
  VIDEO
  NONE
}

enum LandscapeTheme {
  GLASS_RED
  MINIMAL_WHITE
  BOLD_DARK
  CENTERED_GLASS
  RIGHT_INDUSTRIAL
  CLEAN_MODERN
}

// Models
model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  firstName           String
  lastName            String
  phone               String?              @db.VarChar(32)
  role                UserRole             @default(CUSTOMER)
  refreshToken        String?
  addresses           Address[]
  orders              Order[]
  cart                Cart?
  reviews             ProductReview[]
  auditLogs           AuditLog[]
  passwordResetTokens PasswordResetToken[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([email])
}

model Address {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  name       String
  street1    String
  city       String
  state      String?
  postalCode String?
  country    String
  phone      String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Category {
  id                  String              @id @default(cuid())
  name                String
  slug                String              @unique
  description         String?
  image               String? // Category image for UI display
  parent              Category?           @relation("CategoryHierarchy", fields: [parentId], references: [id])
  parentId            String?
  children            Category[]          @relation("CategoryHierarchy")
  products            Product[]
  promotionCategories PromotionCategory[]
  departmentsAsParent Department[]        @relation("DepartmentParentCategory")
  highlightedInDepartments DepartmentHighlightedSubcategory[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([slug])
  @@index([parentId])
}

model Product {
  id                String             @id @default(cuid())
  name              String
  slug              String             @unique
  description       String?
  specs             Json?
  currency          String             @default("USD")
  isActive          Boolean            @default(true)
  isFeatured        Boolean            @default(false)
  isOnSale          Boolean            @default(false)
  discountType      DiscountType?
  discountValue     Decimal?           @db.Decimal(10, 2)
  saleStartsAt      DateTime?
  saleEndsAt        DateTime?
  defaultVariantId  String?
  defaultVariant    ProductVariant?    @relation("DefaultVariant", fields: [defaultVariantId], references: [id], onDelete: SetNull)
  category          Category           @relation(fields: [categoryId], references: [id])
  categoryId        String
  // Rating system
  averageRating     Decimal?           @db.Decimal(3, 2) // 0.00 to 5.00
  reviewCount       Int                @default(0)
  reviews           ProductReview[]
  cartItems         CartItem[]
  orderItems        OrderItem[]
  promotionProducts PromotionProduct[]
  variants          ProductVariant[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([slug])
  @@index([categoryId])
  @@index([isActive])
  @@index([isFeatured])
  @@index([defaultVariantId])
  @@index([averageRating])
}

model ProductVariant {
  id                 String          @id @default(cuid())
  product            Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId          String
  sku                String          @unique
  price              Decimal         @db.Decimal(10, 2)
  stock              Int
  options            VariantOption[]
  image              String?
  images             String[]        @default([])
  cartItems          CartItem[]
  orderItems         OrderItem[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  defaultForProducts Product[]       @relation("DefaultVariant")

  @@index([productId])
  @@index([sku])
}

model VariantOption {
  id               String         @id @default(cuid())
  name             String
  value            String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  productVariantId String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model Cart {
  id        String       @id @default(cuid())
  user      User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String?      @unique
  items     CartItem[]
  session   CartSession?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model CartSession {
  id        String   @id @default(cuid())
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId    String   @unique
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model CartItem {
  id        String         @id @default(cuid())
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId    String
  product   Product        @relation(fields: [productId], references: [id])
  productId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  variantId String
  quantity  Int            @default(1)
  unitPrice Decimal        @db.Decimal(10, 2)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  // Unique constraint: can't have same product+variant combination in cart
  @@unique([cartId, productId, variantId])
  @@index([productId])
}

model Order {
  id                String            @id @default(cuid())
  user              User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId            String?
  orderNumber       String            @unique
  status            OrderStatus       @default(PENDING)
  paymentStatus     PaymentStatus     @default(PENDING)
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)
  subtotal          Decimal           @db.Decimal(10, 2)
  tax               Decimal           @db.Decimal(10, 2)
  shipping          Decimal           @db.Decimal(10, 2)
  discount          Decimal           @default(0) @db.Decimal(10, 2)
  total             Decimal           @db.Decimal(10, 2)
  currency          String            @default("USD")
  shippingAddress   Json
  billingAddress    Json?
  guestEmail        String?           @db.VarChar(320)
  guestPhone        String?           @db.VarChar(32)
  accessTokenHash   String?           @db.VarChar(64)
  items             OrderItem[]
  coupons           OrderCoupon[]
  placedAt          DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([userId])
  @@index([status])
  @@index([placedAt])
  @@index([orderNumber])
  @@index([guestEmail])
}

model OrderItem {
  id         String         @id @default(cuid())
  order      Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String
  product    Product        @relation(fields: [productId], references: [id])
  productId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id])
  variantId  String
  quantity   Int
  unitPrice  Decimal        @db.Decimal(10, 2)
  total      Decimal        @db.Decimal(10, 2)
  title      String
  attributes Json?
  createdAt  DateTime       @default(now())

  @@index([orderId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
}

model Coupon {
  id            String        @id @default(cuid())
  code          String        @unique
  description   String?
  type          DiscountType
  value         Decimal       @db.Decimal(10, 2)
  minOrderTotal Decimal?      @db.Decimal(10, 2)
  startsAt      DateTime?
  expiresAt     DateTime?
  usageLimit    Int?
  perUserLimit  Int?
  usedCount     Int           @default(0) // Track total usage
  isActive      Boolean       @default(true)
  orderCoupons  OrderCoupon[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([code])
  @@index([isActive])
}

model OrderCoupon {
  id        String       @id @default(cuid())
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  coupon    Coupon?      @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponId  String?
  code      String // Store code for historical reference even if coupon deleted
  type      DiscountType
  value     Decimal      @db.Decimal(10, 2)
  discount  Decimal      @db.Decimal(10, 2)
  createdAt DateTime     @default(now())

  @@index([orderId])
  @@index([couponId])
}

model Promotion {
  id                  String              @id @default(cuid())
  name                String
  description         String?
  type                DiscountType
  value               Decimal             @db.Decimal(10, 2)
  startsAt            DateTime?
  expiresAt           DateTime?
  isActive            Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  promotionProducts   PromotionProduct[]
  promotionCategories PromotionCategory[]
  heroSlides          HeroSlide[]

  @@index([isActive, startsAt, expiresAt])
}

model PromotionProduct {
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  promotionId String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   String

  @@id([promotionId, productId])
  @@index([productId])
}

model PromotionCategory {
  promotion          Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  promotionId        String
  category           Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId         String
  applyToDescendants Boolean   @default(true)

  @@id([promotionId, categoryId])
  @@index([categoryId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Rating and Review System
model ProductReview {
  id           String   @id @default(cuid())
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId    String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  rating       Int // 1 to 5
  title        String?
  comment      String?
  isVerified   Boolean  @default(false) // Verified purchase
  helpfulCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([productId, userId]) // One review per user per product
  @@index([productId])
  @@index([userId])
  @@index([rating])
  @@index([createdAt])
}

// Announcements Model
model Announcement {
  id        String               @id @default(cuid())
  text      String
  highlight String // Highlighted portion of text
  icon      AnnouncementIconType
  isActive  Boolean              @default(true)
  priority  Int                  @default(0) // Higher = shown first
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([isActive, priority])
  @@index([priority])
}

// Hero Slides Model
model HeroSlide {
  id       String        @id @default(cuid())
  type     HeroSlideType
  priority Int           @default(0) // Higher = shown first
  isActive Boolean       @default(true)
  startsAt DateTime? // Optional start date for scheduling
  endsAt   DateTime? // Optional end date for scheduling

  // Base content fields
  badgeText   String? // Badge text (optional)
  headline    String // Main headline (required)
  highlight   String? // Optional secondary headline part
  description String // Description text (required)

  // CTA (Call to Action)
  ctaLabel String // Primary CTA label
  ctaHref  String // Primary CTA href/link

  // Media configuration
  mediaKind     MediaKind @default(NONE)
  productSlug   String? // For PRODUCT_SPOTLIGHT or media kind PRODUCT
  imageUrl      String? // For LANDSCAPE_IMAGE or media kind IMAGE
  videoUrl      String? // For media kind VIDEO
  mediaAlt      String? // Alt text for images
  mediaPosition String?   @db.VarChar(20) // center | top | bottom | left | right
  mediaAspect   String?   @db.VarChar(20) // landscape | default

  // Promotion link
  promotionId   String?
  promotion     Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  // Type-specific fields stored as JSON for flexibility
  // PRODUCT_SPOTLIGHT: { features?: Array<{ iconName?: string, text: string }> }
  // OFFER: { offerLabel: string, offerEndsAt: string, promoCode?: string }
  // TESTIMONIAL: { quote: string, authorName: string, rating: number, stats?: Array<{ label: string, value: string }> }
  // LANDSCAPE_IMAGE: { theme: LandscapeTheme, content: { badge, headline, highlight, description }, actionButton: { label, href } }
  // CATEGORY_SPOTLIGHT: { categorySlug: string, categoryBullets?: string[] }
  // EDITORS_PICK: { productSlugs: string[], editorNote?: string }
  // COMPARISON_BATTLE: { leftProductSlug: string, rightProductSlug: string, comparisonPoints: Array<{ label, leftValue, rightValue }> }
  // PROMOTION: { promotionId: string, customColors?: { bg: string, text: string } }
  typeSpecificData Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, priority])
  @@index([type])
  @@index([priority])
  @@index([startsAt, endsAt])
  @@index([promotionId])
}

/// "Department Spotlight" configuration for homepage subcategory sections.
/// This is what the Admin `/admin/subcategories` screen manages.
model Department {
  id               String   @id @default(cuid())
  name             String
  isActive         Boolean  @default(true)

  /// Root/parent category this department is based on
  parentCategory   Category @relation("DepartmentParentCategory", fields: [parentCategoryId], references: [id], onDelete: Cascade)
  parentCategoryId String

  /// Ordered list of highlighted subcategories to feature under the parent category
  highlightedSubcategories DepartmentHighlightedSubcategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentCategoryId])
  @@index([isActive])
  @@index([createdAt])
}

/// Join table for ordered highlighted subcategories inside a Department.
model DepartmentHighlightedSubcategory {
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  departmentId String

  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String

  /// Preserves selection order in the admin UI
  sortOrder Int @default(0)

  @@id([departmentId, categoryId])
  @@index([categoryId])
  @@index([departmentId, sortOrder])
}
